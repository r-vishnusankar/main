# Google Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_api_key_here

# Optional: override image model (default: gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation

# Alternative env names (either works):
# GEMINI_API_KEY=
# NANOBANANA_API_KEY=

# Optional: enhance generated images (e.g. Toonify-style). When set, "Enhance" checkbox uses this.
# ENHANCE_IMAGE_API_URL=https://your-enhance-api.com/enhance
# ENHANCE_IMAGE_API_KEY=
# Or: TOONIFY_API_URL= / TOONIFY_API_KEY=

# Publish: Meta (Facebook Page / Instagram)
# META_PAGE_ID=your_page_id
# META_PAGE_ACCESS_TOKEN=your_page_access_token

# Publish: WhatsApp (Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=same_as_meta_or_whatsapp_token
# WHATSAPP_TO_PHONE=919876543210

# Publish: Shopify blog (e-commerce)
# SHOPIFY_STORE=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=your_admin_api_token
# SHOPIFY_BLOG_ID=blog_id_from_shopify_admin

# Optional: secret for cron endpoint (Vercel sets this automatically for Cron Jobs)
# CRON_SECRET=your_cron_secret

# Split deployment: frontend on Netlify, backend on Render
# On Netlify: set NEXT_PUBLIC_API_URL to your Render backend URL (e.g. https://pixmerce-app.onrender.com)
# On Render (backend): set CORS_ORIGINS or NEXT_PUBLIC_APP_URL to your Netlify URL (e.g. https://pixmerce-ai.netlify.app)
# NEXT_PUBLIC_API_URL=https://pixmerce-app.onrender.com
# CORS_ORIGINS=https://pixmerce-ai.netlify.app
